# ~/.zshrc — generated by the Ember installer.
# Everything here is yours to edit; `ember` rewrites only the two marked lines.

# Where Ember lives.
export EMBER="$HOME/.ember"

# Plugins to load, in order. `ember list plugins` shows what's available,
# `ember enable <name>` edits this line for you.
ember_plugins=(git jump zline extract node python macos)

# Prompt. `ember theme <name>` switches it; `ember list themes` shows them all.
EMBER_THEME=spark

# --- optional settings -------------------------------------------------------
# EMBER_ASYNC=0                # compute git prompt info synchronously
# EMBER_PROFILE=1              # record startup timings for `ember profile`
# EMBER_ZLINE_SUGGEST=0        # turn off inline history suggestions
# EMBER_ZLINE_HIGHLIGHT=0      # turn off syntax highlighting
# EMBER_PYTHON_AUTOVENV=0      # don't auto-activate virtualenvs on cd
# EMBER_DISABLE_AUTO_TITLE=1   # leave the terminal title alone

# `ember off` creates ~/.ember-off and this block stops loading, restoring
# whatever your shell did before Ember. `ember on` removes it again.
# If Ember ever breaks your shell:  touch ~/.ember-off
if [ ! -f "$HOME/.ember-off" ]; then
  # Guarded so a missing $EMBER — an unmounted drive, a moved checkout —
  # costs you a plain shell rather than an error on every prompt.
  [ -r "$EMBER/ember.zsh" ] && source "$EMBER/ember.zsh"
fi

# --- your configuration ------------------------------------------------------
# Anything below this line loads after Ember, so it wins any conflict.

# export EDITOR=nvim

# ~/.zshrc — generated by the Kindling installer.
# Everything here is yours to edit; `kindling` rewrites only the two marked lines.

# Where Kindling lives.
export KINDLING="$HOME/.kindling"

# Plugins to load, in order. `kindling list plugins` shows what's available,
# `kindling enable <name>` edits this line for you.
kindling_plugins=(git jump zline extract node python macos)

# Prompt. `kindling theme <name>` switches it; `kindling list themes` shows them all.
KINDLING_THEME=spark

# --- optional settings -------------------------------------------------------
# KINDLING_ASYNC=0                # compute git prompt info synchronously
# KINDLING_PROFILE=1              # record startup timings for `kindling profile`
# KINDLING_ZLINE_SUGGEST=0        # turn off inline history suggestions
# KINDLING_ZLINE_HIGHLIGHT=0      # turn off syntax highlighting
# KINDLING_PYTHON_AUTOVENV=0      # don't auto-activate virtualenvs on cd
# KINDLING_DISABLE_AUTO_TITLE=1   # leave the terminal title alone

# `kindling off` creates ~/.kindling-off and this block stops loading, restoring
# whatever your shell did before Kindling. `kindling on` removes it again.
# If Kindling ever breaks your shell:  touch ~/.kindling-off
if [ ! -f "$HOME/.kindling-off" ]; then
  # Guarded so a missing $KINDLING — an unmounted drive, a moved checkout —
  # costs you a plain shell rather than an error on every prompt.
  [ -r "$KINDLING/kindling.zsh" ] && source "$KINDLING/kindling.zsh"
fi

# --- your configuration ------------------------------------------------------
# Anything below this line loads after Kindling, so it wins any conflict.

